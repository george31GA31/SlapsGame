{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "publicPlayers": {
      ".read": true,
      ".indexOn": [
        "elo"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['username','country','flag','elo','wins','losses','stats_slaps_won','stats_slaps_lost','stats_rounds_won','stats_rounds_lost','stats_total_time_sec'])",
        "username": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 30"
        },
        "country": {
          ".validate": "newData.isString() && newData.val().length <= 4"
        },
        "flag": {
          ".validate": "newData.isString() && newData.val().length <= 180"
        },
        "elo": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "wins": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "losses": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "stats_slaps_won": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "stats_slaps_lost": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "stats_rounds_won": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "stats_rounds_lost": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "stats_total_time_sec": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "matchHistory": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": [
          "endedAt"
        ],
        "$match": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['endedAt','opponent','won','roundsWon','roundsLost','slapsWon','slapsLost','source'])",
          "endedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "opponent": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "won": {
            ".validate": "newData.isBoolean()"
          },
          "roundsWon": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "roundsLost": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "slapsWon": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "slapsLost": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "source": {
            ".validate": "newData.val() === 'peer-match'"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "profilePictures": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length <= 150000 && newData.val().beginsWith('data:image/jpeg;base64,')"
      }
    },
    "competitions": {
      ".read": false,
      ".write": false
    },
    "_competitionLimits": {
      ".read": false,
      ".write": false
    },
    "casualCompetitions": {
      "$room": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && newData.exists() && ((!data.exists() && newData.child('host').val() === auth.uid && newData.child('playerCount').val() === 1 && newData.child('players').child(auth.uid).exists()) || data.child('players').child(auth.uid).exists() || (data.child('status').val() === 'lobby' && newData.child('status').val() === 'lobby' && (newData.child('host').val() === data.child('host').val() || !data.child('host').exists() || data.child('players').child(data.child('host').val()).child('lastSeen').val() < now - 45000) && newData.child('players').child(auth.uid).exists() && newData.child('playerCount').val() === data.child('playerCount').val() + 1))",
        ".validate": "$room.matches(/^[A-F0-9]{12}$/) && newData.hasChildren(['mode','status','version','createdAt']) && ((!data.exists() && newData.child('status').val() === 'lobby') || (data.exists() && newData.child('mode').val() === data.child('mode').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
        "mode": {
          ".validate": "newData.val() === 'league' || newData.val() === 'tournament'"
        },
        "status": {
          ".validate": "newData.val() === 'lobby' || newData.val() === 'active' || newData.val() === 'complete'"
        },
        "version": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "actionAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "host": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "champion": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "players": {
          "$uid": {
            ".validate": "newData.hasChildren(['id','name','joinedAt','lastSeen','ready']) && newData.child('id').val() === $uid && (root.child('casualCompetitions').child($room).child('players').child(auth.uid).exists() || $uid === auth.uid || (newData.child('id').val() === data.child('id').val() && newData.child('name').val() === data.child('name').val() && newData.child('joinedAt').val() === data.child('joinedAt').val() && newData.child('lastSeen').val() === data.child('lastSeen').val() && newData.child('ready').val() === data.child('ready').val()))",
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "lastSeen": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "matches": {
          ".validate": "!newData.child('190').exists()"
        },
        "$other": {
          ".validate": false
        },
        "playerCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && (newData.parent().child('mode').val() === 'league' || newData.val() <= 8)"
        }
      }
    }
  }
}
